{
  "appearance": {
    "palette": {
      "type": "auto"
    },
    "transparency": {
      "enable": true
    },
    "wallpaperTheming": {
      "enableAppsAndShell": true,
      "enableQtApps": true,
      "enableTerminal": true,
      "terminalGenerationProps": {
        "forceDarkMode": false,
        "harmonizeThreshold": 100,
        "harmony": 0.6,
        "termFgBoost": 0.35
      }
    }
  },
  "background": {
    "wallpaperPath": "/home/dawn/Pictures/Wallpapers/LavisMoonOsuBackground.png",
    "thumbnailPath": ""
  },
  "battery": {
    "low": 20,
    "critical": 10,
    "full": 101,
    "automaticSuspend": true,
    "suspend": 3
  },
  "conflictKiller": {
    "autoKillNotificationDaemons": true,
    "autoKillTrays": true
  },
  "language": {
    "ui": "en_US"
  },
  "launcher": {
    "pinnedApps": [
      "org.kde.dolphin",
      "kitty",
      "cmake-gui"
    ]
  },
  "musicRecognition": {
    "timeout": 16,
    "interval": 4
  },
  "networking": {
    "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/123.0.0.0 Safari/537.36"
  },
  "resources": {
    "updateInterval": 3000
  },
  "screenRecord": {
    "savePath": "$HOME/Videos"
  },
  "screenSnip": {
    "savePath": "$HOME/Pictures/ScreenShots"
  },
  "search": {
    "engineBaseUrl": "https://www.google.com/search?q=",
    "sloppy": false,
    "prefix": {
      "action": "/",
      "clipboard": ";",
      "emojis": ":",
      "math": "=",
      "shellCommand": "$",
      "webSearch": "?"
    }
  },
  "sidebar": {
    "quickToggles": {
      "android": {
        "columns": 5,
        "toggles": [
          {
            "size": 2,
            "type": "network"
          },
          {
            "size": 1,
            "type": "bluetooth"
          },
          {
            "size": 1,
            "type": "idleInhibitor"
          },
          {
            "size": 1,
            "type": "darkMode"
          },
          {
            "size": 1,
            "type": "mic"
          },
          {
            "size": 1,
            "type": "audio"
          },
          {
            "size": 1,
            "type": "colorPicker"
          }
        ]
      }
    }
  },
  "time": {
    "format": "h:mm AP"
  },
  "tray": {
    "pinnedItems": [
      "Fcitx"
    ],
    "invertPinnedItems": true
  },
  "policies": {
    "weeb": 1
  },
  "wallpaperSelector": {
    "useSystemFileDialog": false
  },
  "overlay": {
    "floatingImage": {
      "scale": 0.5
    }
  }
}
