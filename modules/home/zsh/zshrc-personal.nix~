{pkgs, ...}: {
  home.packages = with pkgs; [zsh];

  home.file."./.zshrc-personal".text = ''

    # This file allows you to define your own aliases, functions, etc
    # below are just some examples of what you can use this file for

      #!/usr/bin/env zsh
      # Set defaults
      #
      #export EDITOR="nvim"
      #export VISUAL="nvim"

      #alias c="clear"
      alias dawn-hosts="cd ~/dawnbreakos/hosts/Dawnbreak-Laptop"
      alias dawn-module="cd ~/dawnbreakos/modules/home"
      alias prime-run='__NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia "$@"'
      alias ls="ls"
      alias atlauncher="/home/dawn/Desktop/Dawnbreak\ Launcher/atlauncher"
      export zane="$HOME/dawnbreakos"
      alias workf="kate ~/dawnbreakos"
      if [ -e /run/current-system/etc/set-environment ]; then
        . /run/current-system/etc/set-environment
      fi
  '';
}
